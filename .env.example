# Copy to .env and fill in
OPENROUTER_API_KEY=
RATING_MODEL=google/gemini-2.5-flash-lite
SEARCH_MODEL=deepseek/deepseek-v4-flash
CACHE_TTL_SECONDS=3600
DB_PATH=data/spectrum.db
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Prod Postgres (docker-compose.prod.yml). Leave unset for local SQLite dev.
# DATABASE_URL=postgresql+psycopg://spectrum:changeme@db:5432/spectrum
# POSTGRES_PASSWORD=changeme
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=7
